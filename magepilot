#!/usr/bin/env bash
# Magepilot — one command for the whole stack: install, serve, and use.
#   ./magepilot help
set -euo pipefail

# Resolve symlinks so `magepilot` works when symlinked onto PATH (e.g. ~/.local/bin/magepilot).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
VENV="$ROOT/mlx-env"
RUNDIR="$ROOT/.magepilot"
LOGDIR="$ROOT/logs"
# Prefer a locally-built model (no download) if present; else pull from HuggingFace once.
# Newest local fuse wins (v5 = the iter-640 val-minimum retrain, 2026-06-12).
_DEFAULT_MODEL="navindbhudiya/qwen2.5-coder-7b-magento-v2"
[ -f "$ROOT/models/qwen2.5-coder-7b-magento-v4/config.json" ] && _DEFAULT_MODEL="$ROOT/models/qwen2.5-coder-7b-magento-v4"
[ -f "$ROOT/models/qwen2.5-coder-7b-magento-v5/config.json" ] && _DEFAULT_MODEL="$ROOT/models/qwen2.5-coder-7b-magento-v5"
[ -f "$ROOT/models/qwen2.5-coder-7b-magento-v5.1/config.json" ] && _DEFAULT_MODEL="$ROOT/models/qwen2.5-coder-7b-magento-v5.1"
MODEL="${MAGEPILOT_MODEL:-$_DEFAULT_MODEL}"
MODEL_PORT=8080
RAG_PORT=8090

# The directory you launched magepilot from is the project it works on
# (used by /code, /sql, /suggest, …). Override with AGENT_CODEBASE or --root.
export AGENT_CODEBASE="${AGENT_CODEBASE:-$PWD}"

c_blue=$'\033[94m'; c_green=$'\033[92m'; c_yellow=$'\033[93m'; c_red=$'\033[91m'; c_off=$'\033[0m'
info() { echo "${c_blue}magepilot${c_off} $*"; }
ok()   { echo "${c_green}✓${c_off} $*"; }
warn() { echo "${c_yellow}!${c_off} $*"; }
die()  { echo "${c_red}✗${c_off} $*" >&2; exit 1; }

need_venv() { [ -x "$VENV/bin/python" ] || die "environment missing — run: ./magepilot install"; }
activate()  { need_venv; # shellcheck disable=SC1091
              source "$VENV/bin/activate"
              # self-heal after a `git pull`: older envs predate the magepilot package
              python -c "import magepilot" 2>/dev/null || {
                command -v uv >/dev/null 2>&1 || die "environment outdated — run: ./magepilot install"
                info "updating environment (new package layout)…"
                uv pip install -q -e "$ROOT" || die "package install failed — run: ./magepilot install"
              }; }
up() { curl -s -m 3 "http://127.0.0.1:$1/v1/models" >/dev/null 2>&1; }
# MLX (the bundled model server) publishes wheels for Apple Silicon only. Elsewhere we
# skip mlx-lm and the user points the stack at their own server via MODEL_SERVER.
is_apple_silicon() { [ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ]; }

# ----------------------------------------------------------------------------- install
cmd_install() {
  command -v uv >/dev/null 2>&1 || die "uv not found — install it first:  brew install uv"
  [ -d "$VENV" ] || { info "creating Python environment (mlx-env)…"; uv venv "$VENV"; }
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
  # 'protobuf<7' is REQUIRED: mlx-lm pulls protobuf 7.x, which makes the resolver drop
  # chromadb's opentelemetry exporter back to 1.11.1, whose generated _pb2 files crash on
  # import under protobuf 7 ("Descriptors cannot be created directly"). Capping protobuf at
  # <7 keeps protobuf 6.x + a modern (1.42.x) otel stack, so chromadb imports cleanly.
  if is_apple_silicon; then
    info "installing magepilot + dependencies (mlx-lm, chromadb, prompt_toolkit)…"
    uv pip install -q -e "$ROOT[mlx]"
  else
    warn "not Apple Silicon — skipping mlx-lm (MLX is Apple-Silicon only)."
    warn "serve a model yourself and export MODEL_SERVER (see README's Linux/Windows section)."
    info "installing magepilot + dependencies (chromadb, prompt_toolkit)…"
    uv pip install -q -e "$ROOT"
  fi
  info "building the Magento knowledge base…"
  python "$ROOT/rag/ingest.py" >/dev/null
  _link_to_path
  ok "installed. Next:  magepilot serve"
}

# Symlink `magepilot` into a PATH dir so end users can run it from any project directory.
_link_to_path() {
  local target="" d
  for d in "$HOME/.local/bin" /usr/local/bin /opt/homebrew/bin; do
    case ":$PATH:" in *":$d:"*) [ -d "$d" ] && [ -w "$d" ] && { target="$d"; break; } ;; esac
  done
  [ -n "$target" ] || { target="$HOME/.local/bin"; mkdir -p "$target"; }
  if ln -sf "$ROOT/magepilot" "$target/magepilot" 2>/dev/null; then
    case ":$PATH:" in
      *":$target:"*) ok "'magepilot' added to your PATH ($target) — open a new terminal, then run it from any project" ;;
      *) warn "linked $target/magepilot, but it's not on PATH — add it:"
         echo "      echo 'export PATH=\"$target:\$PATH\"' >> ~/.zshrc && exec zsh" ;;
    esac
  else
    warn "couldn't symlink into $target — run with the full path, or symlink it yourself"
  fi
}

# ----------------------------------------------------------------------------- serve / stop / status
cmd_serve() {
  activate; mkdir -p "$RUNDIR" "$LOGDIR"

  # First-run model pull: default to plain-HTTPS downloads. HuggingFace's Xet transfer
  # (hf_xet) can hang indefinitely mid-download on some networks with no timeout, which
  # strands the very first `serve` at a few MB. Plain HTTPS is reliable; override by
  # exporting HF_HUB_DISABLE_XET=0 if you want Xet's dedup back.
  export HF_HUB_DISABLE_XET="${HF_HUB_DISABLE_XET:-1}"

  if ! is_apple_silicon; then
    if [ -n "${MODEL_SERVER:-}" ]; then
      ok "non-Apple host — using your MODEL_SERVER ($MODEL_SERVER) for the model"
    else
      warn "non-Apple host — the bundled MLX model server is unavailable (MLX is Apple-Silicon only)."
      warn "serve a model yourself and export MODEL_SERVER (e.g. Ollama: http://localhost:11434/v1) — see README."
    fi
  elif up "$MODEL_PORT"; then
    ok "model server already up on :$MODEL_PORT"
  else
    info "starting model server on :$MODEL_PORT (first run downloads ~4 GB → logs/model.log)…"
    nohup mlx_lm.server --model "$MODEL" --host 127.0.0.1 --port "$MODEL_PORT" \
      --temp 0.3 --top-p 0.95 >"$LOGDIR/model.log" 2>&1 &
    echo $! >"$RUNDIR/model.pid"
    printf "   waiting for the model to load"
    for _ in $(seq 1 120); do up "$MODEL_PORT" && break; printf "."; sleep 2; done
    echo
    up "$MODEL_PORT" && ok "model server ready on :$MODEL_PORT" \
                     || warn "not ready yet — still loading? check logs/model.log"
  fi

  if up "$RAG_PORT"; then
    ok "RAG proxy already up on :$RAG_PORT"
  else
    info "starting RAG proxy on :${RAG_PORT}…"
    nohup python "$ROOT/rag/rag_server.py" >"$LOGDIR/rag.log" 2>&1 &
    echo $! >"$RUNDIR/rag.pid"
    # first start imports chromadb + the embedder (~5-10 s) — poll instead of a fixed sleep
    for _ in $(seq 1 30); do up "$RAG_PORT" && break; sleep 0.5; done
    up "$RAG_PORT" && ok "RAG proxy ready on :$RAG_PORT  (use this for chat)" \
                   || warn "RAG proxy starting — check logs/rag.log"
  fi
  echo; info "ready. Try:  ./magepilot ask \"When do I use a plugin vs a preference?\""
}

cmd_stop() {
  for svc in model rag; do
    pidf="$RUNDIR/$svc.pid"
    [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null && ok "stopped $svc" || true
    rm -f "$pidf"
  done
  # Sweep every lingering magepilot process the PID files missed: the model server (any
  # magento model — covers a server started before the model path changed), the RAG proxy,
  # and any stuck helper (a hung make/ask). Scoped so it never kills this stop script or an
  # interactive `magepilot` REPL.
  pkill -f "mlx_lm.server.*magento"   2>/dev/null || true
  pkill -f "mlx_lm.server --model $MODEL" 2>/dev/null || true
  pkill -f "rag/rag_server.py"        2>/dev/null || true
  pkill -f "rag/ask.py"               2>/dev/null || true
  pkill -f "[-]m magepilot (index|run|suggest|watch|sql|make|undo)" 2>/dev/null || true
  ok "stopped."
}

cmd_status() {
  up "$MODEL_PORT" && ok "model server  :$MODEL_PORT  UP" || warn "model server  :$MODEL_PORT  down"
  up "$RAG_PORT"   && ok "RAG proxy     :$RAG_PORT  UP"   || warn "RAG proxy     :$RAG_PORT  down"
}

# ----------------------------------------------------------------------------- use
cmd_ask()     { activate; python "$ROOT/rag/ask.py" "$@"; }
cmd_agent()   { activate; cd "$ROOT"; python -m magepilot "$@"; }   # index|run|suggest|watch|sql

usage() {
  cat <<EOF
${c_blue}Magepilot${c_off} — local AI coding assistant for Magento 2 & Hyvä

${c_green}Interactive${c_off}
  ./magepilot                      start the interactive assistant (type questions, /commands)

${c_green}Setup${c_off}
  ./magepilot install              create the env, install deps, build the knowledge base
  ./magepilot serve                start the model server (:$MODEL_PORT) + RAG proxy (:$RAG_PORT)
  ./magepilot stop                 stop both servers
  ./magepilot status               show what's running

${c_green}Use${c_off}
  ./magepilot ask "<question>"            ask the grounded assistant
  ./magepilot index --root <store>        index a Magento codebase for the agent
  ./magepilot run "<task>"                ask the agent about the indexed codebase
  ./magepilot do "<objective>"            plan + execute a multi-step objective (approve each change)
  ./magepilot resume [run-id]             continue a paused/interrupted run
  ./magepilot runs                        list recent runs
  ./magepilot make "<task>"               create/edit files for a task (approve each change)
  ./magepilot undo                        revert the files changed by the last make
  ./magepilot suggest --root <store>      propose & run the Magento commands your changes need
  ./magepilot watch --root <store>        keep proposing commands as you edit files
  ./magepilot sql --root <store> "<SQL>"  run a read-only query against the store DB
  ./magepilot mcp-serve --root <store>    expose the tools as an MCP stdio server (for Claude Code etc.)
  ./magepilot testgen "<FQCN>"            generate a PHPUnit unit test for a class

  (index/run/suggest/watch/sql forward straight to the agent CLI — all its flags work.)

${c_green}Tips${c_off}
  • Override the model:  MAGEPILOT_MODEL=<hf-id-or-path> ./magepilot serve
  • Non-Apple hosts: set MODEL_SERVER to your own OpenAI-compatible server (see README).
  • Put it on PATH:  ln -s "$ROOT/magepilot" /usr/local/bin/magepilot   (then just: magepilot …)
EOF
}

# ----------------------------------------------------------------------------- dispatch
cmd="${1:-chat}"; shift || true
case "$cmd" in
  chat)               activate; cd "$ROOT"; exec python -m magepilot ;;    # interactive shell (default)
  install)            cmd_install "$@" ;;
  serve|start)        cmd_serve "$@" ;;
  stop)               cmd_stop "$@" ;;
  status)             cmd_status "$@" ;;
  ask)                cmd_ask "$@" ;;
  index|run|suggest|watch|sql|make|undo|do|resume|runs|graph|review|testgen) cmd_agent "$cmd" "$@" ;;
  mcp-serve)          activate 1>&2; cd "$ROOT"; exec python -m magepilot mcp-serve "$@" ;;
  help|-h|--help)     usage ;;
  *)                  warn "unknown command: $cmd"; echo; usage; exit 1 ;;
esac